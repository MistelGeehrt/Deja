# Copie ce fichier en .env et remplis les valeurs.

# Le cerveau de l'agent : UNE des deux clés suffit (Anthropic est utilisée en priorité si les deux sont là).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Modèle imposé (facultatif). Défaut : claude-sonnet-5-5 ou gpt-4o-mini selon la clé.
DEJA_MODEL=

# Adresse publique du wallet qui encaisse la commission (celui de MistelGeehrt).
DEJA_PLATFORM_WALLET=

# Réseau Solana. devnet = argent de test. Ne passe en mainnet-beta qu'en version 2.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Prix d'une réutilisation (en millionièmes d'USDC) : 100000 = 0,10 USDC
DEJA_PRICE_MICRO_USDC=100000
# Commission en points de base : 500 = 5 %
DEJA_FEE_BPS=500

# Mettre à 1 pour tester sans blockchain (les paiements sont acceptés sans vérification).
DEJA_SKIP_CHAIN_VERIFY=0

PORT=8787

# --- Site public et semeur ---
# Adresse publique du site (pour Google et les liens), ex. https://deja.mistelgeehrt.com
DEJA_PUBLIC_URL=http://localhost:8787
# Nombre maximal d'avis traités par passage du semeur (4 analyses par avis)
DEJA_SEED_MAX=50
# Mot de passe du tableau de bord : http://.../tableau?cle=CE_MOT
DEJA_DASHBOARD_KEY=
